# Copy to .env for local development. NEVER commit the filled-in .env.
# In production these are set as Render environment variables.

# --- AI gateway (PRD 28) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Endpoint auth (PRD 50) ---
AGENT_SECRET=

# --- Email (PRD 46) ---
# smtp:     no provider account and no sender verification -- the mailbox is already
#           yours. Gmail needs an App Password with 2FA enabled. NOTE: Render's free
#           tier blocks outbound ports 25/465/587, so this needs a paid instance.
# sendgrid: sends over HTTPS, so no port is blocked. Needs a verified sender.
# resend:   sends over HTTPS. Needs a DNS-verified domain; best deliverability.
EMAIL_PROVIDER=smtp

# Used when EMAIL_PROVIDER is smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Used when EMAIL_PROVIDER is sendgrid or resend
EMAIL_API_KEY=
SENDER_EMAIL=
RECIPIENT_EMAIL=

# --- Behaviour (PRD 55) ---
TIMEZONE=Asia/Kolkata
GLOBAL_TOP_N=5
NICHE_TOP_N=5
DATA_RETENTION_DAYS=31

# --- Optional source providers (PRD 55). RSS works with none of these. ---
NEWS_API_KEY=
SEARCH_API_KEY=

# --- Git-backed CSV persistence (PRD 8) ---
# Fine-grained PAT with contents:write on MelbourneMama-CreativeSpace/Trending-Topics
GITHUB_TOKEN=
GITHUB_DATA_REPO=MelbourneMama-CreativeSpace/Trending-Topics
GITHUB_DATA_BRANCH=main
