# Copy to .env for local development. NEVER commit the filled-in .env.
# In production these are set as Render environment variables.

# --- AI gateway (PRD 28) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Endpoint auth (PRD 50) ---
AGENT_SECRET=

# --- Email (PRD 46) ---
# sendgrid: Single Sender Verification needs no DNS -- verify one address by clicking
#   a link SendGrid emails you, then send to anyone.
# resend:   needs a DNS-verified sending domain, but gives proper DMARC alignment.
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=
SENDER_EMAIL=
RECIPIENT_EMAIL=

# --- Behaviour (PRD 55) ---
TIMEZONE=Asia/Kolkata
GLOBAL_TOP_N=5
NICHE_TOP_N=5
DATA_RETENTION_DAYS=31

# --- Optional source providers (PRD 55). RSS works with none of these. ---
NEWS_API_KEY=
SEARCH_API_KEY=

# --- Git-backed CSV persistence (PRD 8) ---
# Fine-grained PAT with contents:write on MelbourneMama-CreativeSpace/Trending-Topics
GITHUB_TOKEN=
GITHUB_DATA_REPO=MelbourneMama-CreativeSpace/Trending-Topics
GITHUB_DATA_BRANCH=main
